import tkinter as tk
from tkinter import messagebox

def check_ticket():
    try:
        height = float(height_entry.get())
        
        if height < 3.0:
            result_label.config(text="❌ Sorry, you cannot ride.", fg="red")
            return
            
        age = int(age_entry.get())
        
        if age < 12:
            bill = 150
        elif age <= 18:
            bill = 250
        else:
            bill = 500
            
        result_label.config(
            text=f"✅ You can ride!\n💵 Pay: {bill} rupees", 
            fg="green"
        )
        
    except ValueError:
        messagebox.showerror("Error", "Please enter valid numbers for height and age.")

# Create the main window
root = tk.Tk()
root.title("Theme Park Ticket System")
root.geometry("350x300")
root.config(bg="#1e1e1e")

# UI Elements
tk.Label(root, text="🎢 Ticket System", font=("Arial", 16, "bold"), fg="white", bg="#1e1e1e").pack(pady=10)

tk.Label(root, text="Enter Height (feet):", fg="white", bg="#1e1e1e").pack()
height_entry = tk.Entry(root, font=("Arial", 12))
height_entry.pack(pady=5)

tk.Label(root, text="Enter Age:", fg="white", bg="#1e1e1e").pack()
age_entry = tk.Entry(root, font=("Arial", 12))
age_entry.pack(pady=5)

tk.Button(root, text="Calculate Ticket", command=check_ticket, bg="#007acc", fg="white", font=("Arial", 11, "bold")).pack(pady=15)

result_label = tk.Label(root, text="", font=("Arial", 12, "bold"), bg="#1e1e1e")
result_label.pack(pady=10)

# Run the window application
root.mainloop()